# Connection settings for the superaggregator service.
# Copy this file to ".env" only if you need to override the defaults.
#
# The bot defaults to the public instance and needs NO login, so you can
# usually skip all of this.

# Override the instance URL (default: https://superaggregator.fly.dev)
# SUPERAGRIGRATOR_BASE_URL=https://superaggregator.fly.dev

# Optional API key — only set this if your instance requires auth.
# SUPERAGRIGRATOR_API_KEY=

# Optional: per-request timeout in seconds (default 10)
# SUPERAGRIGRATOR_TIMEOUT=10
